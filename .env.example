# ── 데이터베이스 ─────────────────────────────────────────
# 로컬 PostgreSQL 이면 두 값을 똑같이 넣으면 됩니다.
# Neon 이면 DATABASE_URL = Pooled(주소에 -pooler 포함), DATABASE_URL_UNPOOLED = Direct 주소
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/interest_platform?schema=public"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@localhost:5432/interest_platform?schema=public"

# ── 로그인(NextAuth) ─────────────────────────────────────
# 아무도 모르는 긴 랜덤 문자열 (예: https://generate-secret.vercel.app/32 에서 생성)
NEXTAUTH_SECRET="여기에-랜덤-문자열"
AUTH_TRUST_HOST=true

# ── 일일 배치(Cron) 보호용 비밀값 ─────────────────────────
CRON_SECRET="여기에-랜덤-문자열"

# ── 최초 관리자 계정 (배포 시 자동 생성) ───────────────────
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="8자이상-나만아는-비밀번호"

# 자체 서버(next start)로 운영할 때만 true. Vercel 에서는 자동 비활성화됨
ENABLE_NODE_CRON=false
